{
	"id":"UDF_yamato_sabot",
	"specClass":"missile",	
	"missileType":"MIRV",
	"sprite":"graphics/missiles/rift_torpedo_purple.png",
	"size":[30,100],	
	"center":[15,50],
	"fadeTime":0.2,
	"collisionRadius":16,
		"dudProbabilityOnFlameout":0,
	"collisionClass":"MISSILE_NO_FF",
	"explosionColor":[100,100,255,0],  # purely visual, will get a white additively blended core on top of this color
	"explosionRadius":125, # purely visual
	"engineSpec":{"turnAcc":0,
				  "turnRate":0,
				  "acc":100,
				  "dec":0},
	"engineSlots":[{"id":"ES1",
					"loc":[0, 0],
				    "style":"CUSTOM",
					"styleSpec":{	
						"mode":"QUAD_STRIP", # PARTICLES or QUAD_STRIP, determines which params are used
						#"engineColor":[255,145,75,255],
						"engineColor":[100,100,255,0],
						"glowAlternateColor":[100,100,255,0],
						"contrailDuration":2,
						"contrailWidthMult":5,
						"contrailWidthAddedFractionAtEnd":2,  # can be negative. makes trail spread out/narrow at the end
						"contrailMinSeg":7, # min segment length, in pixels
						"contrailMaxSpeedMult":.0f,
						"contrailAngularVelocityMult":0.5f,
						"contrailSpawnDistMult":.5, # how far away from engine it starts
						"contrailColor":[100,100,255,0],
				    	"glowSizeMult":1,
						"type":"SMOKE" # GLOW or SMOKE; additive or regular blend mode
					},
				    "width":1.0,
				    "length":1.0,
				    "angle":180.0}],
	"behaviorSpec":{"behavior":"MIRV",
					"splitRange":400,
					"splitRangeRange":100,
					"minTimeToSplit":0.1,
					"canSplitEarly":true,
					"splitSound":"hydra_split",
					"numShots":25,
					"damage":5,
					"emp":0, # needs to match highlight in weapon_data.csv
					"damageType":HIGH_EXPLOSIVE,
					"hitpoints":500,
					"evenSpread":true,
					"arc":20,
					"spreadInaccuracy":5,
					#"spreadSpeed":300,
					"spreadSpeed":1000,
					"spreadSpeedRange":500,
					"projectileRange":600, # only needed if not a missile
					"projectileSpec":"UDF_yamato_warhead",
					"smokeSpec":{"particleSizeMin":20.0,
								 "particleSizeRange":20.0,
								 "cloudParticleCount":11,
								 "cloudDuration":1.0,
								 "cloudRadius":20.0,
								 "blowbackParticleCount":50,
								 "blowbackDuration":0,
								 "blowbackLength":-100,
								 "blowbackSpread":0,
								 "particleColor":[150,150,255,255]}
					
					}				    
