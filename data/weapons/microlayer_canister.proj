{
	"id":"microlayer_proj",
	"specClass":"missile",
	"missileType":"BOMB",
	"onFireEffect":"com.fs.starfarer.api.impl.combat.CanisterFlakPlugin",
	"sprite":"graphics/missiles/canister_flak.png",
	"size":[6,10],	
	"center":[3,5],
	"collisionRadius":9,
	"collisionClass":"MISSILE_NO_FF",
	"collisionClassByFighter":"PROJECTILE_FIGHTER",
	"explosionColor":[15,94,230,255],  # purely visual, will get a white additively blended core on top of this color
	"explosionRadius":100, # purely visual
	"fizzleOnReachingWeaponRange":true,
	"noCollisionWhileFading":false,
	"useHitGlowWhenDealingDamage":false, # using the scripted rift explosion instead
	"useHitGlowWhenDestroyed":false,
	"flameoutTime":0.05, # total time from flameout to full fadeout
	"noEngineGlowTime":0.05, # time spent without the engine glow being rendered
	"fadeTime":0.05, # fadeout duration		
	"explosionSpec":{"duration":30f, # not visual
					 "radius":1075,
					 "coreRadius":1075, # full damage within core radius
					 "collisionClass":MISSILE_NO_FF,
					 "collisionClassByFighter":PROJECTILE_FIGHTER},
	"behaviorSpec":{"behavior":"PROXIMITY_FUSE",
					#"slowToMaxSpeed":true,
					"range":40,
					"explosionSpec":{"duration":10f,
									 "radius":575,
									 "coreRadius":575, # full damage within core radius - at least equal to proximity fuse range
									 "collisionClass":MISSILE_NO_FF,
									 "collisionClassByFighter":PROJECTILE_FIGHTER,
									 "particleSizeMin":4.0,
									 "particleSizeRange":4.0,
									 "particleDuration":10,
									 "particleCount":50,
									 "particleColor":[15,94,230,255],
									 "explosionColor":[15,94,230,255],
									 "useDetailedExplosion":true,
									 "useDetailedExplosionColorAlpha":true,
									 "detailedExplosionRadius":1158,
									 "detailedExplosionFlashRadius":50,
									 "detailedExplosionFlashDuration":0.2,
									 "detailedExplosionFlashColorFringe":[200,175,100,10],
									 "detailedExplosionFlashColorCore":[200,175,100,10],
									 "sound":"system_canister_flak_explosion"},									 
					},
	"engineSpec":{"turnAcc":100,
				  "turnRate":200,
				  "acc":100,
				  "dec":100}
